{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from \"axios\";\nexport default {\n  name: \"LoginForm\",\n  data() {\n    return {\n      email: \"\",\n      password: \"\",\n      loginErrorMessage: \"\"\n    };\n  },\n  methods: {\n    async handleLogin() {\n      try {\n        const response = await axios.post(\"http://localhost:400/Users/login\", {\n          email: this.email,\n          password: this.password\n        });\n        console.log(\"Respuesta de backend (login):\", response.data);\n\n        // Si el inicio de sesión es exitoso, redirigir a /listaForm\n        this.$router.push(\"/listaForm\");\n      } catch (error) {\n        this.loginErrorMessage = \"Error al iniciar sesión. Verifica tus credenciales.\";\n        console.error(\"Error al hacer login:\", error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","email","password","loginErrorMessage","methods","handleLogin","response","post","console","log","$router","push","error"],"sources":["C:\\Users\\JOSE\\Documents\\GitHub\\TallerSoftware\\frontcapi\\src\\components\\LoginForm.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-page d-flex align-items-center justify-content-center\">\r\n    <div class=\"login-container card p-4 shadow-lg\">\r\n      <h2 class=\"text-center mb-4\">👋 ¡Hola! Inicia sesión</h2>\r\n\r\n      <!-- Formulario de inicio de sesión -->\r\n      <form @submit.prevent=\"handleLogin\" class=\"login-form\">\r\n        <div class=\"form-group mb-3\">\r\n          <label for=\"email\" class=\"form-label\">📧 Correo electrónico:</label>\r\n          <input \r\n            type=\"email\" \r\n            id=\"email\" \r\n            v-model=\"email\" \r\n            placeholder=\"Introduce tu correo electrónico\" \r\n            class=\"form-control\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <div class=\"form-group mb-3\">\r\n          <label for=\"password\" class=\"form-label\">🔑 Contraseña:</label>\r\n          <input \r\n            type=\"password\" \r\n            id=\"password\" \r\n            v-model=\"password\" \r\n            placeholder=\"Introduce tu contraseña\" \r\n            class=\"form-control\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <button type=\"submit\" class=\"btn btn-primary btn-lg w-100 mb-3\">\r\n          🚀 Iniciar sesión\r\n        </button>\r\n\r\n        <p v-if=\"loginErrorMessage\" class=\"error-message text-danger\">{{ loginErrorMessage }}</p>\r\n      </form>\r\n\r\n      <hr class=\"my-4\">\r\n\r\n      <!-- Enlace para redirigir a la página de crear cuenta -->\r\n      <p class=\"create-account-text text-center\">\r\n        ¿No tienes cuenta? <router-link to=\"/CrearUser\" class=\"text-decoration-none\">👉 Crear usuario nuevo</router-link>\r\n      </p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  name: \"LoginForm\",\r\n  data() {\r\n    return {\r\n      email: \"\",\r\n      password: \"\",\r\n      loginErrorMessage: \"\"\r\n    };\r\n  },\r\n  methods: {\r\n    async handleLogin() {\r\n      try {\r\n        const response = await axios.post(\"http://localhost:400/Users/login\", {\r\n          email: this.email,\r\n          password: this.password,\r\n        });\r\n\r\n        console.log(\"Respuesta de backend (login):\", response.data);\r\n\r\n        // Si el inicio de sesión es exitoso, redirigir a /listaForm\r\n        this.$router.push(\"/listaForm\");\r\n\r\n      } catch (error) {\r\n        this.loginErrorMessage = \"Error al iniciar sesión. Verifica tus credenciales.\";\r\n        console.error(\"Error al hacer login:\", error);\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* Estilos para la página de login */\r\n.login-page {\r\n  min-height: 100vh;\r\n  background: #f8f9fa; /* Fondo suave */\r\n  padding: 20px;\r\n}\r\n\r\n.login-container {\r\n  max-width: 500px;\r\n  width: 100%;\r\n  border: none;\r\n  border-radius: 15px;\r\n  background-color: #ffffff;\r\n  padding: 30px;\r\n  box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\nh2 {\r\n  color: #ff7f50; /* Naranja amigable */\r\n  font-size: 2rem;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.form-label {\r\n  font-weight: bold;\r\n  color: #555;\r\n}\r\n\r\n.form-control {\r\n  border-radius: 10px;\r\n  border: 2px solid #ddd;\r\n  padding: 10px;\r\n  font-size: 1rem;\r\n}\r\n\r\n.btn-primary {\r\n  background-color: #ff7f50; /* Naranja amigable */\r\n  border: none;\r\n  border-radius: 10px;\r\n  padding: 12px;\r\n  font-size: 1.2rem;\r\n  transition: background-color 0.3s ease;\r\n}\r\n\r\n.btn-primary:hover {\r\n  background-color: #ff6347; /* Naranja más oscuro al pasar el mouse */\r\n}\r\n\r\n.error-message {\r\n  font-size: 1rem;\r\n  margin-top: 20px;\r\n}\r\n\r\n.create-account-text {\r\n  font-size: 1rem;\r\n  margin-top: 20px;\r\n}\r\n\r\n.create-account-text a {\r\n  color: #ff7f50; /* Naranja amigable */\r\n  text-decoration: none;\r\n}\r\n\r\n.create-account-text a:hover {\r\n  text-decoration: underline;\r\n}\r\n</style>"],"mappings":";AAiDA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,iBAAiB,EAAE;IACrB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,WAAWA,CAAA,EAAG;MAClB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMR,KAAK,CAACS,IAAI,CAAC,kCAAkC,EAAE;UACpEN,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,QAAQ,EAAE,IAAI,CAACA;QACjB,CAAC,CAAC;QAEFM,OAAO,CAACC,GAAG,CAAC,+BAA+B,EAAEH,QAAQ,CAACN,IAAI,CAAC;;QAE3D;QACA,IAAI,CAACU,OAAO,CAACC,IAAI,CAAC,YAAY,CAAC;MAEjC,EAAE,OAAOC,KAAK,EAAE;QACd,IAAI,CAACT,iBAAgB,GAAI,qDAAqD;QAC9EK,OAAO,CAACI,KAAK,CAAC,uBAAuB,EAAEA,KAAK,CAAC;MAC/C;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}