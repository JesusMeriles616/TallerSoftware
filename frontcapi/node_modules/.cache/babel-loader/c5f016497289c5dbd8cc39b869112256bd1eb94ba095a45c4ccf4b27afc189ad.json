{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  data() {\n    return {\n      isMenuActive: false\n    };\n  },\n  methods: {\n    closeSession() {\n      localStorage.clear();\n      this.$router.push('/');\n    }\n  }\n};","map":{"version":3,"names":["data","isMenuActive","methods","closeSession","localStorage","clear","$router","push"],"sources":["C:\\Users\\JOSE\\Documents\\GitHub\\TallerSoftware\\frontcapi\\src\\components\\NavBar.vue"],"sourcesContent":["<template>\r\n   <nav class=\"navbar\" role=\"navigation\" aria-label=\"main navigation\">\r\n  <div class=\"navbar-brand\">\r\n    <div class=\"navbar-item\" @click=\"navigateTo('home')\" style=\"flex-grow: 1; justify-content: center; display: flex; align-items: center;\">\r\n      <img src=\"@/assets/capibara.jpg\" alt=\"Logo\" style=\"max-height: 80px; margin-right: 10px;\">\r\n      <div class=\"rainbow-text\">\r\n        <h3>Grupo Capibara</h3>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <p class=\"rainbow\">JUEGO COLORES</p> <!-- Aquí agregamos el texto centrado -->\r\n  <div class=\"navbar-menu\" :class=\"{ 'is-active': isMenuActive }\">\r\n    <div class=\"navbar-start\">\r\n      <div class=\"auth-buttons\">\r\n        <router-link to=\"/LoginForm\" class=\"auth-button\">Login</router-link>\r\n        <button @click=\"closeSession\" class=\"auth-button\">Cerrar Sesión</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</nav>\r\n\r\n  </template>\r\n  \r\n  \r\n  <script>\r\n  export default {\r\n    data() {\r\n      return {\r\n        isMenuActive: false\r\n      };\r\n    },\r\n    methods: {\r\n      closeSession() {\r\n        localStorage.clear();\r\n        this.$router.push('/');\r\n      }\r\n    }\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  nav {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    padding: 10px 30px;\r\n    background-color: #79bfd4; /* Fondo azul */\r\n    border-bottom: 8px solid #116eba; /* Línea azul debajo del navbar */\r\n    color: #4a4a4a;\r\n  }\r\n  \r\n  .navbar-item {\r\n    color: #dee6eb; /* Asegúrate de que los ítems sean visibles sobre fondo azul */\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .navbar-item:hover {\r\n    color: #dc14cb; /* Color cuando el usuario pasa el mouse */\r\n  }\r\n  \r\n  .icon {\r\n    color: #1b1010; /* Ajusta el color de los íconos */\r\n  }\r\n  \r\n  button {\r\n    background-color: transparent;\r\n    border: none;\r\n    color: #1fc4c4;\r\n    cursor: pointer; /* Asegúrate de que el cursor sea de tipo pointer en los botones */\r\n  }\r\n  \r\n  button:hover {\r\n    color: #ff00e6;\r\n  }\r\n  \r\n  /* Estilos para los botones Login y Cerrar Sesión */\r\n  .auth-buttons {\r\n    display: flex;\r\n    justify-content: space-around; /* Los botones estarán alineados horizontalmente */\r\n    gap: 20px; /* Espacio entre los botones */\r\n  }\r\n  \r\n  .auth-button {\r\n    background-color: #aaaaa8;\r\n    border: none;\r\n    color: #116eba;\r\n    padding: 20px 50px; /* Aumentamos el tamaño de los botones */\r\n    font-size: 20px; /* Aumentamos el tamaño de la fuente */\r\n    font-weight: bold; /* Hacemos el texto más grueso */\r\n    text-align: center;\r\n    cursor: pointer;\r\n    border-radius: 5px;\r\n    transition: background-color 0.3s ease, transform 0.3s ease;\r\n  }\r\n  \r\n  .auth-button:hover {\r\n    background-color: #5b5855;\r\n    transform: scale(1.05); /* Agrandar ligeramente al pasar el mouse */\r\n  }\r\n  \r\n  /* Estilos para el navbar burger */\r\n  .navbar-burger span {\r\n    display: block;\r\n    height: 3px;\r\n    background-color: #4a4a4a;\r\n    margin: 5px auto;\r\n    transition: transform 0.3s ease;\r\n  }\r\n  \r\n  /* Ajustes para pantallas pequeñas */\r\n  @media (max-width: 768px) {\r\n    .navbar-menu {\r\n      display: flex;\r\n      flex-direction: column;\r\n      align-items: center;\r\n      width: 100%;\r\n      background-color: #fff;\r\n      position: absolute;\r\n      top: 70px;\r\n      left: 0;\r\n      right: 0;\r\n      padding: 10px 0;\r\n      transition: transform 0.3s ease;\r\n      transform: translateY(-100%);\r\n    }\r\n  \r\n    .navbar-menu.is-active {\r\n      transform: translateY(0);\r\n    }\r\n  \r\n    /* En pantallas pequeñas los botones estarán en columna */\r\n    .auth-buttons {\r\n      flex-direction: column;\r\n    }\r\n  \r\n    .auth-button {\r\n      font-size: 18px;\r\n      padding: 15px 40px;\r\n    }\r\n  }\r\n  .auth-button {\r\n  font-size: 16px;\r\n  padding: 10px 20px;\r\n  background-color: #3498db;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  text-transform: uppercase;\r\n  text-align: center;\r\n  position: relative;\r\n  overflow: hidden;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.auth-button:hover {\r\n  background-color: #2980b9;\r\n}\r\n\r\n.auth-button {\r\n  font-size: 16px;\r\n  padding: 10px 20px;\r\n  background-color: #3498db;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  position: relative;\r\n  animation: glowing 1.5s infinite ease-in-out alternate;\r\n}\r\n\r\n/* Efecto de brillo */\r\n@keyframes glowing {\r\n  0% {\r\n    text-shadow: 0 0 5px #fff, 0 0 10px #3498db, 0 0 15px #3498db, 0 0 20px #3498db;\r\n  }\r\n  50% {\r\n    text-shadow: 0 0 10px #fff, 0 0 20px #3498db, 0 0 30px #3498db, 0 0 40px #3498db;\r\n  }\r\n  100% {\r\n    text-shadow: 0 0 5px #fff, 0 0 10px #3498db, 0 0 15px #3498db, 0 0 20px #3498db;\r\n  }\r\n}\r\n\r\n/* Efecto de movimiento en hover */\r\n.auth-button:hover {\r\n  animation: movingButton 1s ease-in-out infinite;\r\n}\r\n\r\n@keyframes movingButton {\r\n  0% {\r\n    transform: scale(1);\r\n  }\r\n  50% {\r\n    transform: scale(1.1);\r\n  }\r\n  100% {\r\n    transform: scale(1);\r\n  }\r\n}\r\n.rainbow {\r\n  font-size: 20px;\r\n  font-weight: bold;\r\n  animation: rainbow 4s infinite linear;\r\n  text-align: center;\r\n  width: 60%;\r\n  margin: 0; /* Para evitar márgenes adicionales que afecten el posicionamiento */\r\n}\r\n@keyframes rainbow {\r\n  0% {\r\n    color: #ff0000; /* Rojo */\r\n  }\r\n  15% {\r\n    color: #ff7f00; /* Naranja */\r\n  }\r\n  30% {\r\n    color: #ffff00; /* Amarillo */\r\n  }\r\n  45% {\r\n    color: #00ff00; /* Verde */\r\n  }\r\n  60% {\r\n    color: #0000ff; /* Azul */\r\n  }\r\n  75% {\r\n    color: #4b0082; /* Índigo */\r\n  }\r\n  100% {\r\n    color: #9400d3; /* Violeta */\r\n  }\r\n  \r\n}\r\n\r\n  </style>\r\n  "],"mappings":";AAyBE,eAAe;EACbA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,YAAY,EAAE;IAChB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,YAAYA,CAAA,EAAG;MACbC,YAAY,CAACC,KAAK,CAAC,CAAC;MACpB,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,GAAG,CAAC;IACxB;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}